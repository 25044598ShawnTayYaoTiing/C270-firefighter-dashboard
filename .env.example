PORT=3000
FRONTEND_PORT=3000
# Internal Compose URL used by the frontend UI gateway. Do not use this URL in browser code.
BACKEND_URL=http://backend:3000
SESSION_SECRET=replace_with_a_long_random_value

DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=firefighter_dashboard

# Current cloud AI provider: Gemini Flash.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional per-attempt Gemini timeout in milliseconds.
GEMINI_TIMEOUT_MS=30000

# When running Node directly, use 127.0.0.1. Compose overrides this to reach a host-side service.
REALTIME_STT_HEALTH_URL=http://127.0.0.1:8010/health
# Leave blank to make browsers use the dashboard hostname on port 8010.
REALTIME_STT_WS_URL=

ONEMAP_EMAIL=
ONEMAP_PASSWORD=
ONEMAP_BASE_URL=https://www.onemap.gov.sg
GEOCODING_DEBUG=false
