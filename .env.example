PORT=3000
SESSION_SECRET=replace_with_a_long_random_value

DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=firefighter_dashboard

# Use http://ollama:11434 in Docker and http://localhost:11434 outside Docker.
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=qwen2.5:1.5b

# Docker uses its service name for the server-side health check.
REALTIME_STT_HEALTH_URL=http://realtimestt:8010/health
# Leave blank to make browsers use the dashboard hostname on port 8010.
REALTIME_STT_WS_URL=

ONEMAP_EMAIL=
ONEMAP_PASSWORD=
ONEMAP_BASE_URL=https://www.onemap.gov.sg
GEOCODING_DEBUG=false
