NODE_ENV=development
FRONTEND_PORT=3000
BACKEND_PORT=3001
# The base Compose file deliberately uses http://backend:3000. BACKEND_URL is
# retained here as the frontend image's ECS/runtime contract.
BACKEND_URL=http://backend:3000
CORS_ORIGIN=http://localhost:3000
SESSION_SECRET=

# External MySQL/Railway database. These values are required by Compose; no
# database container is created.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Gemini is called only by the backend container.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=30000

# Google Cloud Speech-to-Text V1 uses Application Default Credentials.
# Run `gcloud auth application-default login` locally; do not add a key file here.
GOOGLE_CLOUD_PROJECT=project-1e4380d5-44ee-49d4-b26
# Leave GOOGLE_AUTH_MODE unset for local Application Default Credentials.
# ECS/Fargate only: GOOGLE_AUTH_MODE=aws-wif and AWS_REGION are non-secret config.
GOOGLE_AUTH_MODE=
# Optional Compose GCP overlay only. Set this to the absolute path of the
# existing local ADC file; keep that file outside the repository.
GOOGLE_APPLICATION_CREDENTIALS_HOST=

ONEMAP_EMAIL=
ONEMAP_PASSWORD=
ONEMAP_BASE_URL=https://www.onemap.gov.sg
GEOCODING_DEBUG=false
