NODE_ENV=development
FRONTEND_PORT=3000
BACKEND_PORT=3001
# Local Compose value; for ECS frontend deployment set the backend service URL,
# for example: BACKEND_URL=https://your-backend-ecs-application-url
BACKEND_URL=http://backend:3000
CORS_ORIGIN=http://localhost:3000
SESSION_SECRET=replace_with_a_long_random_value

# External MySQL/Railway database. No database container is created by Compose.
DB_HOST=mysql-host.example.com
DB_PORT=3306
DB_USER=mysql_username
DB_PASSWORD=replace_with_mysql_password
DB_NAME=firefighter_dashboard

# Gemini is called only by the backend container.
GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=30000

# Google Cloud Speech-to-Text V1 uses Application Default Credentials.
# Run `gcloud auth application-default login` locally; do not add a key file here.
GOOGLE_CLOUD_PROJECT=project-1e4380d5-44ee-49d4-b26
# Leave GOOGLE_AUTH_MODE unset for local Application Default Credentials.
# ECS/Fargate only: GOOGLE_AUTH_MODE=aws-wif and AWS_REGION are non-secret config.
GOOGLE_AUTH_MODE=

ONEMAP_EMAIL=
ONEMAP_PASSWORD=
ONEMAP_BASE_URL=https://www.onemap.gov.sg
GEOCODING_DEBUG=false
