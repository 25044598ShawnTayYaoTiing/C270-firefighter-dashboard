    "@google-cloud/speech": "^8.1.1",
    "@google/genai": "^2.28.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^18.0.7",
    "ejs": "^7.0.1",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "google-auth-library": "^11.2.0",
    "leaflet.heat": "^0.2.0",
    "leaflet.markercluster": "^1.5.3",
    "mysql2": "^3.24.5",
    "ws": "^8.22.0"
  },
  "overrides": {
    "google-gax": {
      "rimraf": "6.1.3"
