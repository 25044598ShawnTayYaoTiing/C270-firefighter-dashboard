{
  "name": "firefighter-smart-incident-dashboard",
  "version": "1.0.0",
  "description": "Frontend MVP dashboard for a firefighter incident reporting school prototype.",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "node app.js",
    "demo": "powershell -ExecutionPolicy Bypass -File scripts/start-demo.ps1",
    "gemini:deployment:demo": "node scripts/deployment-analysis/demo/runDemo.js",
    "gemini:deployment:smoke:live": "node scripts/deployment-analysis/runLiveGeminiSmoke.js",
    "compose:smoke": "node scripts/compose-smoke.js",
    "frontend:container-test": "node scripts/frontend-container-smoke.js",
