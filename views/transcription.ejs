<section class="transcription-layout" data-realtime-stt-ws-url="<%= realtimeSttWsUrl %>">
  <article class="panel">
    <div class="panel-header stacked-mobile">
      <div>
        <p class="eyebrow">Operator Tool</p>
        <h2>Live Call Transcript</h2>
      </div>
      <span class="status-badge status-draft" id="transcriptionState">Checking</span>
    </div>

    <div class="notice-strip" id="transcriptionNotice">
      <i class="bi bi-info-circle-fill"></i>
      <span>Checking call transcription service.</span>
    </div>

    <%# Done by: Khin (25036933) %>
    <%# Show the live and finalized transcript areas side by side so operators can review speech output as it arrives. %>
    <div class="transcript-display" id="transcriptDisplay" aria-live="polite">
      <div class="transcript-section">
        <span>Full Transcript</span>
        <div class="transcript-text" id="fullTranscriptDisplay">
          <p class="empty-transcript">No completed transcript yet.</p>
        </div>
      </div>
      <div class="transcript-section">
        <span>Live Transcript</span>
        <div class="transcript-text" id="liveTranscriptDisplay">
          <p class="empty-transcript">Waiting for speech input...</p>
        </div>
      </div>
    </div>

    <%# Done BY SHAWN ID 25044598 %>
    <%# AI Features: cleaned transcript output lets officers review Gemini-cleaned text before report generation. %>
    <label class="cleaned-transcript">
      <span>Cleaned Transcript</span>
      <textarea class="form-control" id="cleanedTranscriptInput" rows="8" placeholder="Cleaned transcript will appear here. You can edit it before sending it to Create Report."></textarea>
    </label>

    <%# Done by: Khin (25036933) %>
    <%# Display status messages for the AI cleanup step so the user knows whether the transcript is ready or needs attention. %>
    <div class="notice-strip notice-hidden" id="cleanupNotice">
      <i class="bi bi-info-circle-fill"></i>
      <span></span>
    </div>

    <%# Done by: Khin (25036933) %>
    <%# Provide the main action buttons for starting, stopping, clearing, cleaning, and sending the transcript. %>
    <div class="form-actions transcription-actions">
      <button class="primary-button" type="button" id="startTranscriptionButton">
        <i class="bi bi-record-circle-fill"></i>
        Start Transcription
      </button>
      <button class="secondary-button" type="button" id="stopTranscriptionButton" disabled>
        <i class="bi bi-stop-circle-fill"></i>
        Stop Transcription
      </button>
      <button class="ghost-button" type="button" id="clearTranscriptButton">
        <i class="bi bi-x-circle-fill"></i>
        Clear Transcript
      </button>
      <%# Done BY SHAWN ID 25044598 %>
      <%# AI Features: sends transcript text to the backend cleanup endpoint. %>
      <button class="secondary-button" type="button" id="cleanTranscriptButton">
        <i class="bi bi-stars"></i>
        Clean Transcript
      </button>
      <button class="ghost-button" type="button" id="sendTranscriptButton">
        <i class="bi bi-send-fill"></i>
        Send Raw Transcript
      </button>
      <%# Done BY SHAWN ID 25044598 %>
      <%# AI Features: forwards reviewed cleaned transcript text into Create Report for AI draft generation. %>
      <button class="primary-button" type="button" id="sendCleanTranscriptButton">
        <i class="bi bi-send-check-fill"></i>
        Send Clean Transcript
      </button>
    </div>
  </article>

  <aside class="panel">
    <div class="panel-header">
      <div>
        <p class="eyebrow">Operations</p>
        <h2>System Status</h2>
      </div>
    </div>

    <%# Done by: Khin (25036933) %>
    <%# Show the availability of the real-time voice service, AI cleanup service, and database in one place. %>
    <div class="connection-list">
      <span class="status-pill" id="realtimeServiceStatus">
        <span class="status-dot"></span>
        <span class="status-name">Call Transcription Service</span>
      </span>
      <span class="status-pill" id="aiServiceStatus">
        <span class="status-dot"></span>
        <span class="status-name">Report Drafting Service</span>
      </span>
      <span class="status-pill" id="databaseStatus">
        <span class="status-dot"></span>
        <span class="status-name">Database</span>
      </span>
    </div>

    <%# Done by: Khin (25036933) %>
    <%# Give operators a fallback path if the real-time voice service is unavailable or not accessible. %>
    <label class="manual-transcript">
      <span>Manual Transcript Input</span>
      <textarea class="form-control" id="manualTranscriptInput" rows="18" placeholder="Paste transcript text here if the call transcription service is unavailable."></textarea>
    </label>
  </aside>
</section>
