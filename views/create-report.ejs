<%
  const form = typeof formData !== 'undefined' && formData ? formData : {};
  const errors = typeof validationErrors !== 'undefined' && validationErrors ? validationErrors : {};
  const selectedIncidentType = form.incidentType || '';
  const useCustomIncidentType = selectedIncidentType && !incidentTypes.includes(selectedIncidentType);
  const selectedResponseStatus = form.responseStatus || 'Pending Review';
  const fieldError = (name) => errors[name] || '';
  const fieldClass = (name) => fieldError(name) ? ' is-invalid' : '';
  const locationVerified = form.locationVerified === 'true';
%>

<section class="form-grid">
  <article class="panel transcript-panel">
    <div class="panel-header">
      <div>
        <p class="eyebrow">Call Transcript</p>
        <h2>Draft From Transcript</h2>
      </div>
    </div>

    <%# Done BY SHAWN ID 25044598 %>
    <%# AI Features: transcript input supplies text for Gemini-based incident draft generation. %>
    <div class="mb-3">
      <label class="form-label" for="transcriptInput">Transcript</label>
      <textarea class="form-control" id="transcriptInput" name="transcript" form="reportForm" rows="16" placeholder="Paste an incident call transcript here..."><%= form.transcript || '' %></textarea>
    </div>

    <%# Done BY SHAWN ID 25044598 %>
    <%# AI Features: this button starts AI report drafting from the transcript. %>
    <button class="primary-button w-100" type="button" id="generateDraftButton">
      <i class="bi bi-magic"></i>
      Generate Draft
    </button>
    <p class="helper-text">Creates an editable draft from the transcript. Nothing is saved until an officer reviews and submits the report.</p>
  </article>

  <article class="panel report-draft-panel">
    <div class="panel-header">
      <div>
        <p class="eyebrow">Officer Review</p>
        <h2>Incident Report Draft</h2>
      </div>
    </div>

    <%- include('partials/report-completion', { completion }) %>

    <%# SHAWN 25044598 - Restore/Discard Draft: Hidden until a temporary report draft is detected. %>
    <div class="draft-recovery notice-strip notice-hidden" id="draftRecoveryNotice">
      <i class="bi bi-clock-history"></i>
      <div>
        <span id="draftRecoveryMessage"></span>
        <div class="draft-recovery-actions">
          <button class="secondary-button" type="button" id="restoreCreateReportDraftButton">Restore Draft</button>
          <button class="ghost-button" type="button" id="discardCreateReportDraftButton">Discard Draft</button>
        </div>
      </div>
    </div>

    <%# Done BY SHAWN ID 25044598 %>
    <%# AI Features: officer review form receives and edits AI-generated report draft fields before saving. %>
    <form class="report-form" id="reportForm" data-completion-form data-incident-form action="/incidents" method="POST" novalidate>
      <input type="hidden" id="reportingOfficerId" name="reportingOfficerId" value="<%= currentOfficer ? currentOfficer.officer_id : '' %>">
      <input type="hidden" id="incidentLatitude" name="latitude" value="<%= form.latitude || '' %>">
      <input type="hidden" id="incidentLongitude" name="longitude" value="<%= form.longitude || '' %>">
      <input type="hidden" id="locationVerified" name="locationVerified" value="<%= locationVerified ? 'true' : '' %>">
      <input type="hidden" id="locationVerificationSource" name="locationVerificationSource" value="<%= form.locationVerificationSource || '' %>">
      <input type="hidden" id="verifiedLocationLabel" name="verifiedLocationLabel" value="<%= form.verifiedLocationLabel || '' %>">

      <% if (Object.keys(errors).length > 0) { %>
        <div class="notice-strip notice-warning" data-form-error-summary>
          <i class="bi bi-exclamation-triangle-fill"></i>
          <span>Please correct the highlighted fields before saving this incident report.</span>
        </div>
      <% } %>

      <div class="readonly-field">
        <span>Reporting Officer</span>
        <strong><%= currentOfficer ? currentOfficer.officer_name : 'Not assigned' %></strong>
        <% if (currentOfficer && currentOfficer.officer_role) { %>
          <small><%= currentOfficer.officer_role %></small>
        <% } %>
      </div>

      <div class="form-row">
        <div class="location-field-group">
          <label>
            <span>Incident Location <b class="required-marker">*</b></span>
            <input class="form-control<%= fieldClass('incidentLocation') %>" id="incidentLocation" name="incidentLocation" type="text" value="<%= form.incidentLocation || '' %>" required aria-describedby="incidentLocationError locationVerificationMessage">
          </label>
          <small class="field-error" id="incidentLocationError" <%= fieldError('incidentLocation') ? '' : 'hidden' %>><%= fieldError('incidentLocation') %></small>
          <div class="location-verification" data-location-verification data-state="<%= locationVerified ? 'VERIFIED' : 'UNVERIFIED' %>">
            <div class="location-action-row">
              <button class="secondary-button" id="verifyLocationButton" type="button">
                <i class="bi bi-crosshair"></i>
                Verify Location
              </button>
              <span class="location-status location-status-pending" id="locationVerificationStatus" role="status">
                <i class="bi bi-dash-circle-fill"></i>
                UNVERIFIED
              </span>
            </div>
            <div class="location-feedback" id="locationVerificationMessage" aria-live="polite">
              Verify the address before saving this report.
            </div>
            <section class="location-candidates" id="locationCandidates" aria-labelledby="locationCandidatesTitle" hidden>
              <div>
                <strong id="locationCandidatesTitle">Choose the matching location</strong>
                <span>Confirm the correct result before it is treated as verified.</span>
              </div>
              <div class="location-candidate-list" id="locationCandidateList" role="list"></div>
            </section>
            <section class="verified-location-card" id="verifiedLocationCard" tabindex="-1" aria-label="Verified incident location" <%= locationVerified ? '' : 'hidden' %>>
              <div class="verified-location-heading">
                <span class="verified-location-icon"><i class="bi bi-geo-alt-fill"></i></span>
                <div>
                  <small>Verified incident location</small>
                  <strong id="verifiedLocationName"><%= form.verifiedLocationLabel || form.incidentLocation || '' %></strong>
                </div>
              </div>
              <p id="verifiedLocationAddress"><%= form.verifiedLocationLabel || form.incidentLocation || '' %></p>
            </section>
            <div class="location-preview-map" id="locationPreviewMap" <%= locationVerified ? '' : 'hidden' %>></div>
            <p class="helper-text location-coordinate-readout" id="locationCoordinateReadout" <%= locationVerified ? '' : 'hidden' %>>
              Coordinates: <span><%= form.latitude || '' %>, <%= form.longitude || '' %></span>
            </p>
          </div>
        </div>
        <div>
          <label>
            <span>Incident Type <b class="required-marker">*</b></span>
            <select class="form-select<%= fieldClass('incidentType') %>" id="incidentType" name="incidentType" required aria-describedby="incidentTypeError">
              <option value="">Select type</option>
              <% incidentTypes.forEach((type) => { %>
                <option <%= selectedIncidentType === type ? 'selected' : '' %>><%= type %></option>
              <% }) %>
              <option value="__other_special_incident__" <%= useCustomIncidentType ? 'selected' : '' %>>Other / Special Incident</option>
            </select>
          </label>
          <small class="field-error" id="incidentTypeError" <%= fieldError('incidentType') ? '' : 'hidden' %>><%= fieldError('incidentType') %></small>
          <label id="customIncidentTypeField" <%= useCustomIncidentType ? '' : 'hidden' %>>
            <span>Custom Incident Type <b class="required-marker">*</b></span>
            <input class="form-control" id="customIncidentType" name="customIncidentType" type="text" value="<%= useCustomIncidentType ? selectedIncidentType : form.customIncidentType || '' %>">
          </label>
        </div>
      </div>

      <div class="form-row">
        <label>
          <span>Date and Time <b class="required-marker">*</b></span>
          <input class="form-control<%= fieldClass('incidentDateTime') %>" id="incidentDateTime" name="incidentDateTime" type="datetime-local"
            value="<%= (form.incidentDateTime || serverDateTime).slice(0, 16) %>"
            <% if (!canManageIncidentDateTime) { %>readonly data-server-controlled="true"<% } %> required aria-describedby="incidentDateTimeError">
          <% if (!canManageIncidentDateTime) { %>
            <small class="helper-text">Incident date and time is automatically recorded by the server for standard officers and HR.</small>
          <% } else { %>
            <small class="helper-text">Higher Rank/Admin may adjust this operational timestamp when required.</small>
          <% } %>
          <small class="field-error" id="incidentDateTimeError" <%= fieldError('incidentDateTime') ? '' : 'hidden' %>><%= fieldError('incidentDateTime') %></small>
        </label>
        <label>
          <span>Response Status <b class="required-marker">*</b></span>
          <select class="form-select<%= fieldClass('responseStatus') %>" id="responseStatus" name="responseStatus" required aria-describedby="responseStatusError">
            <% statuses.forEach((status) => { %>
              <option <%= selectedResponseStatus === status ? 'selected' : '' %>><%= status %></option>
            <% }) %>
          </select>
          <small class="field-error" id="responseStatusError" <%= fieldError('responseStatus') ? '' : 'hidden' %>><%= fieldError('responseStatus') %></small>
        </label>
      </div>

      <label>
        <span>Incident Summary <b class="required-marker">*</b></span>
        <textarea class="form-control<%= fieldClass('incidentSummary') %>" id="incidentSummary" name="incidentSummary" rows="4" required aria-describedby="incidentSummaryError"><%= form.incidentSummary || '' %></textarea>
        <small class="field-error" id="incidentSummaryError" <%= fieldError('incidentSummary') ? '' : 'hidden' %>><%= fieldError('incidentSummary') %></small>
      </label>

      <label>
        <span>Hazards</span>
        <textarea class="form-control" id="hazards" name="hazards" rows="3"><%= form.hazards || '' %></textarea>
        <small class="field-error" id="hazardsError" <%= fieldError('hazards') ? '' : 'hidden' %>><%= fieldError('hazards') %></small>
        <span class="conditional-confirmation">
          <input type="checkbox" id="noHazardsReported" name="noHazardsReported" value="true">
          <span>No hazards reported</span>
        </span>
      </label>

      <label>
        <span>Injured or Trapped Persons</span>
        <textarea class="form-control" id="injuredPersons" name="injuredPersons" rows="3"><%= form.injuredPersons || '' %></textarea>
        <small class="field-error" id="injuredPersonsError" <%= fieldError('injuredPersons') ? '' : 'hidden' %>><%= fieldError('injuredPersons') %></small>
        <span class="conditional-confirmation">
          <input type="checkbox" id="noInjuredPersonsReported" name="noInjuredPersonsReported" value="true">
          <span>No injured or trapped persons reported</span>
        </span>
      </label>

      <label>
        <span>Missing Information</span>
        <textarea class="form-control" id="missingInfo" name="missingInfo" rows="3"><%= form.missingInfo || '' %></textarea>
      </label>

      <label>
        <span>Officer Notes</span>
        <textarea class="form-control" id="officerNotes" name="officerNotes" rows="3"><%= form.officerNotes || '' %></textarea>
      </label>

      <div class="form-actions">
        <button class="secondary-button" type="submit" name="saveMode" value="draft" formnovalidate>
          <i class="bi bi-save-fill"></i>
          Save Draft
        </button>
        <button class="primary-button" type="submit" name="saveMode" value="report">
          <i class="bi bi-check2-circle"></i>
          Save Report
        </button>
        <button class="ghost-button" type="reset">
          <i class="bi bi-x-circle-fill"></i>
          Clear Form
        </button>
      </div>
    </form>
  </article>
</section>
