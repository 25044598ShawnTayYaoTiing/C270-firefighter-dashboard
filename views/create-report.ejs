<section class="form-grid">
  <article class="panel">
    <div class="panel-header">
      <div>
        <p class="eyebrow">Call Transcript</p>
        <h2>Draft From Transcript</h2>
      </div>
    </div>

    <%# Done BY SHAWN ID 25044598 %>
    <%# AI Features: transcript input supplies text for Ollama-based incident draft generation. %>
    <div class="mb-3">
      <label class="form-label" for="transcriptInput">Transcript</label>
      <textarea class="form-control" id="transcriptInput" name="transcript" form="reportForm" rows="8" placeholder="Paste an incident call transcript here..."></textarea>
    </div>

    <%# Done BY SHAWN ID 25044598 %>
    <%# AI Features: this button starts AI report drafting from the transcript. %>
    <button class="primary-button w-100" type="button" id="generateDraftButton">
      <i class="bi bi-magic"></i>
      Generate Draft
    </button>
    <p class="helper-text">Creates an editable draft from the transcript. Nothing is saved until an officer reviews and submits the report.</p>
    <div class="notice-strip notice-hidden" id="aiReportNotice">
      <i class="bi bi-info-circle"></i>
      <span></span>
    </div>
  </article>

  <article class="panel">
    <div class="panel-header">
      <div>
        <p class="eyebrow">Officer Review</p>
        <h2>Incident Report Draft</h2>
      </div>
    </div>

    <%- include('partials/report-completion', { completion }) %>

    <div class="draft-recovery notice-strip notice-hidden" id="draftRecoveryNotice">
      <i class="bi bi-clock-history"></i>
      <div>
        <span id="draftRecoveryMessage"></span>
        <div class="draft-recovery-actions">
          <button class="secondary-button" type="button" id="restoreCreateReportDraftButton">Restore Draft</button>
          <button class="ghost-button" type="button" id="discardCreateReportDraftButton">Discard Draft</button>
        </div>
      </div>
    </div>

    <%# Done BY SHAWN ID 25044598 %>
    <%# AI Features: officer review form receives and edits AI-generated report draft fields before saving. %>
    <form class="report-form" id="reportForm" data-completion-form action="/incidents" method="POST">
      <input type="hidden" id="reportingOfficerId" name="reportingOfficerId" value="<%= currentOfficer ? currentOfficer.officer_id : '' %>">

      <div class="readonly-field">
        <span>Reporting Officer</span>
        <strong><%= currentOfficer ? currentOfficer.officer_name : 'Not assigned' %></strong>
        <% if (currentOfficer && currentOfficer.officer_role) { %>
          <small><%= currentOfficer.officer_role %></small>
        <% } %>
      </div>

      <div class="form-row">
        <label>
          <span>Incident Location</span>
          <input class="form-control" id="incidentLocation" name="incidentLocation" type="text" required>
        </label>
        <div>
          <label>
            <span>Incident Type</span>
            <select class="form-select" id="incidentType" name="incidentType" required>
              <option value="">Select type</option>
              <% incidentTypes.forEach((type) => { %>
                <option><%= type %></option>
              <% }) %>
              <option value="__other_special_incident__">Other / Special Incident</option>
            </select>
          </label>
          <label id="customIncidentTypeField" hidden>
            <span>Custom Incident Type</span>
            <input class="form-control" id="customIncidentType" name="customIncidentType" type="text">
          </label>
        </div>
      </div>

      <div class="form-row">
        <label>
          <span>Date and Time</span>
          <input class="form-control" id="incidentDateTime" name="incidentDateTime" type="datetime-local" required>
        </label>
        <label>
          <span>Response Status</span>
          <select class="form-select" id="responseStatus" name="responseStatus" required>
            <% statuses.forEach((status) => { %>
              <option><%= status %></option>
            <% }) %>
          </select>
        </label>
      </div>

      <label>
        <span>Incident Summary</span>
        <textarea class="form-control" id="incidentSummary" name="incidentSummary" rows="4" required></textarea>
      </label>

      <label>
        <span>Hazards</span>
        <textarea class="form-control" id="hazards" name="hazards" rows="3"></textarea>
      </label>

      <label>
        <span>Injured or Trapped Persons</span>
        <textarea class="form-control" id="injuredPersons" name="injuredPersons" rows="3"></textarea>
      </label>

      <label>
        <span>Missing Information</span>
        <textarea class="form-control" id="missingInfo" name="missingInfo" rows="3"></textarea>
      </label>

      <label>
        <span>Officer Notes</span>
        <textarea class="form-control" id="officerNotes" name="officerNotes" rows="3"></textarea>
      </label>

      <div class="form-actions">
        <button class="secondary-button" type="submit" name="saveMode" value="draft" formnovalidate>
          <i class="bi bi-save"></i>
          Save Draft
        </button>
        <button class="primary-button" type="submit" name="saveMode" value="report">
          <i class="bi bi-check2-circle"></i>
          Save Report
        </button>
        <button class="ghost-button" type="reset">
          <i class="bi bi-x-circle"></i>
          Clear Form
        </button>
      </div>
    </form>
  </article>
</section>
