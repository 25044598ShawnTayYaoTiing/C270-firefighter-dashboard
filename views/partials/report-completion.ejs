<section class="report-completion" data-report-completion>
  <div class="completion-heading">
    <strong>Report Completion: <span data-completion-percent><%= completion ? completion.percent : 0 %>%</span></strong>
    <span data-completion-message><%= completion ? completion.message : 'Review required before submission.' %></span>
  </div>
  <div class="progress completion-progress">
    <div class="progress-bar" data-completion-bar style="width: <%= completion ? completion.percent : 0 %>%"></div>
  </div>
  <div class="missing-fields">
    <span>Missing fields</span>
    <ul data-missing-fields>
      <% const missingFields = completion ? completion.missingFields : ['Incident Location', 'Incident Type', 'Date and Time', 'Incident Summary', 'Response Status', 'Hazards', 'Injured or Trapped Persons']; %>
      <% if (missingFields.length === 0) { %>
        <li>None</li>
      <% } %>
      <% missingFields.forEach((field) => { %>
        <li><%= field %></li>
      <% }) %>
    </ul>
  </div>
</section>
